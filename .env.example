# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.example .env

# ── Discord ────────────────────────────────────────────────────────────────

# Bot token. https://discord.com/developers/applications → your app →
# Bot → Reset Token. Treat like a password; anyone with it controls the bot.
DISCORD_TOKEN=

# Your test server's ID. Slash commands sync to a single guild instantly,
# while a global sync can take up to an hour — so always set this in dev.
# Discord → User Settings → Advanced → Developer Mode, then right-click the
# server icon → Copy Server ID.
DEV_GUILD_ID=

# ── Model provider ─────────────────────────────────────────────────────────

# Which backend serves NPC dialogue: "ollama" (local) or "anthropic" (API).
# Local is the default. See docs/DECISIONS.md ADR-0001.
LLM_PROVIDER=ollama

# --- ollama (local, default) ---
# Base URL of the Ollama server. Leave as-is if it runs on this machine.
OLLAMA_HOST=http://localhost:11434

# Model per tier. All three may be the same model locally — the tiers exist so
# the routing seam is identical across providers, and so you can drop a smaller
# model into UTILITY later without touching code.
#   DIALOGUE — every NPC line. Quality here is what the table actually feels.
#   UTILITY  — summaries, lore extraction. Cheap and frequent.
#   EPIC     — opt-in via /scene mode epic, for big narrative moments.
OLLAMA_MODEL_DIALOGUE=qwen3.6:27b
OLLAMA_MODEL_UTILITY=qwen3.6:27b
OLLAMA_MODEL_EPIC=qwen3.6:27b

# How long Ollama keeps the model resident after a request. Without this you
# pay multi-second load latency on the first NPC line of every scene.
OLLAMA_KEEP_ALIVE=30m

# --- anthropic (baseline, optional) ---
# Only needed when LLM_PROVIDER=anthropic. Get a key at
# https://console.anthropic.com → API Keys, and SET A MONTHLY SPEND LIMIT
# while you are there (Settings → Limits). This is a metered API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DIALOGUE=claude-sonnet-5
ANTHROPIC_MODEL_UTILITY=claude-haiku-4-5
ANTHROPIC_MODEL_EPIC=claude-opus-5

# ── Storage ────────────────────────────────────────────────────────────────

# SQLite by default. Must be an async driver URL.
DATABASE_URL=sqlite+aiosqlite:///./dnd_helper.db

# ── Logging ────────────────────────────────────────────────────────────────

# DEBUG may include full prompt text (useful for verifying the secrets
# barrier). INFO never does. Use INFO anywhere the logs are shared.
LOG_LEVEL=INFO
